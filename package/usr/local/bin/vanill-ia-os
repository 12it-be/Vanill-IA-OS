#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ==============================================================================
 * Vanill-IA OS — Server CLI Administration & Emergency Recovery Tool
 * Usage:
 *   sudo vanill-ia-os status
 *   sudo vanill-ia-os setup-token
 *   sudo vanill-ia-os reset-2fa <username>
 *   sudo vanill-ia-os unlock-ip <ip|all>
 * ==============================================================================
 */

if (PHP_SAPI !== 'cli' || (function_exists('posix_geteuid') && posix_geteuid() !== 0)) {
    fwrite(STDERR, "Exécutez cet outil en root : sudo vanill-ia-os <commande>\n");
    exit(1);
}

$dbPath = '/var/lib/vanill-ia-os/data/vanill-ia.db';
$tokenFile = '/var/lib/vanill-ia-os/data/setup.token';
$cmd = $argv[1] ?? 'help';

$openDb = static function () use ($dbPath): PDO {
    if (!is_file($dbPath)) {
        fwrite(STDERR, "Base SQLite introuvable : {$dbPath}\n");
        exit(2);
    }
    $pdo = new PDO('sqlite:' . $dbPath, null, null, [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
    $pdo->exec('PRAGMA busy_timeout = 5000;');
    return $pdo;
};

switch ($cmd) {
    case 'status':
        $pdo = $openDb();
        $usersCount = (int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn();
        $setupDone = $usersCount > 0 ? 'Oui (Verrouillé)' : 'Non (En attente du Setup Wizard)';
        $sockOk = file_exists('/run/vanill-ia/agent.sock') ? 'Actif (/run/vanill-ia/agent.sock)' : 'Inactif';
        echo "=== Vanill-IA OS Status ===\n";
        echo "Daemon Système : {$sockOk}\n";
        echo "Setup Initial  : {$setupDone}\n";
        echo "Administrateurs: {$usersCount}\n";
        if ($usersCount === 0 && is_file($tokenFile)) {
            echo "Setup Token    : " . trim((string) file_get_contents($tokenFile)) . "\n";
        }
        break;

    case 'setup-token':
        $pdo = $openDb();
        $usersCount = (int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn();
        if ($usersCount > 0) {
            echo "Le compte administrateur est déjà configuré. Le Setup Wizard est verrouillé.\n";
            exit(0);
        }
        $regen = in_array('--regenerate', $argv, true);
        if (!$regen && is_file($tokenFile)) {
            $token = trim((string) file_get_contents($tokenFile));
        } else {
            $token = strtoupper(bin2hex(random_bytes(8)));
            $hash = password_hash($token, PASSWORD_ARGON2ID);
            $stmt = $pdo->prepare("INSERT INTO settings (key, value, category) VALUES ('security.setup_token_hash', :v, 'security') ON CONFLICT(key) DO UPDATE SET value = excluded.value");
            $stmt->execute([':v' => $hash]);
            file_put_contents($tokenFile, $token . "\n");
            chmod($tokenFile, 0600);
        }
        echo "Jeton d'initialisation (Setup Token) : {$token}\n";
        break;

    case 'reset-2fa':
        $username = trim((string) ($argv[2] ?? ''));
        if ($username === '') {
            fwrite(STDERR, "Usage: sudo vanill-ia-os reset-2fa <username>\n");
            exit(2);
        }
        $pdo = $openDb();
        $stmt = $pdo->prepare('UPDATE users SET totp_enabled = 0, totp_secret = NULL, totp_backup_codes_json = "[]" WHERE username = :u');
        $stmt->execute([':u' => $username]);
        if ($stmt->rowCount() === 0) {
            fwrite(STDERR, "Utilisateur introuvable : {$username}\n");
            exit(3);
        }
        echo "2FA TOTP désactivé avec succès pour l'utilisateur '{$username}'.\n";
        break;

    case 'unlock-ip':
        $target = trim((string) ($argv[2] ?? 'all'));
        $pdo = $openDb();
        if ($target === 'all') {
            $pdo->exec('DELETE FROM auth_attempts');
            echo "Toutes les restrictions anti-bruteforce SQLite ont été levées.\n";
        } else {
            $stmt = $pdo->prepare('DELETE FROM auth_attempts WHERE ip_address = :ip');
            $stmt->execute([':ip' => $target]);
            echo "Restrictions SQLite levées pour l'IP {$target}.\n";
        }
        break;

    default:
        echo "Vanill-IA OS CLI — Commandes disponibles :\n";
        echo "  sudo vanill-ia-os status                    Affiche l'état du WebOS et du daemon\n";
        echo "  sudo vanill-ia-os setup-token [--regenerate] Affiche ou régénère le jeton de premier lancement\n";
        echo "  sudo vanill-ia-os reset-2fa <username>      Désactive le 2FA en cas de perte d'appareil\n";
        echo "  sudo vanill-ia-os unlock-ip <ip|all>        Débloque une IP bannie en SQLite\n";
        break;
}
